// SPDX-License-Identifier: Apache-2.0
// Windows resources: the application icon and version information.
// (Regenerate app.ico with:  python3 resources/make_icon.py)

// ID 1 is the icon Explorer shows for the .exe; GLFW_ICON is the name GLFW looks up for the window,
// taskbar and Alt+Tab icon.
1 ICON "app.ico"
GLFW_ICON ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Print Studios"
            VALUE "FileDescription", "Mesh Inspector - 3D mesh viewer and quality checker"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "meshinspector"
            VALUE "LegalCopyright", "Copyright 2026 Print Studios. Licensed under the Apache License, Version 2.0."
            VALUE "OriginalFilename", "Mesh Inspector.exe"
            VALUE "ProductName", "Mesh Inspector"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
